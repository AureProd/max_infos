{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!.nuxt",
      "!.output",
      "!node_modules",
      "!coverage",
      // SQL migrations generated by drizzle-kit: reviewed by hand, never reformatted.
      "!drizzle",
      "!mockup",
      // Leftover from the mock-up, converted as we go then removed.
      "!frontend",
      "!pnpm-lock.yaml"
    ]
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "useConst": "error" }
    }
  },
  "overrides": [
    {
      // In a test, a non-null assertion that turns out wrong produces an
      // immediate, readable test failure — exactly what we want. The rule
      // keeps all its meaning in app/, server/ and shared/, where an
      // unexpected null would break a page in production.
      "includes": ["test/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      // The two stylesheets carry the whole design. Reformatting them would
      // drown every future review in noise.
      "includes": ["app/assets/css/base.css", "app/assets/css/admin.css"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      // Nuxt mandates these names: file-based routing wants `index.vue`,
      // and the default layout is called `default.vue`. The multi-word name
      // rule therefore does not apply here.
      "includes": ["app/pages/**", "app/layouts/**", "app/app.vue", "app/error.vue"],
      "linter": { "rules": { "style": { "useVueMultiWordComponentNames": "off" } } }
    },
    {
      // Biome's Vue support is experimental: it analyses the <script>
      // WITHOUT reading the <template>. Everything used only in the template
      // is therefore wrongly reported as unused, which would hit every
      // component in the project. vue-tsc (`pnpm typecheck`) understands
      // templates: it is the real safety net on this point.
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" }
        }
      }
    }
  ]
}
