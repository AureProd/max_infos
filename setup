#!/usr/bin/env bash
#
# Generates the root docker-compose.yml from deploy/.
#
#   ./setup [env_file]   prepares the instance (default: the last one used,
#                        otherwise .env.dev)
#   ./setup --show       prints what this folder is set up for, without
#                        regenerating anything
#
# The environment file and the port are remembered in ./.setup-state, so
# that `./setup` alone reuses the folder's settings. It is a cache, not
# configuration: deleting it is harmless.
#
# Recognised variables:
#   URL_PORT         changes the default port (allows several clones side by
#                    side: every published port derives from it)
#   INSTANCE_NAME    changes the Docker Compose project name
#   SKIP_PORT_CHECK  skips the « is this port free » check

set -euo pipefail

STATE_FILE="./.setup-state"

# Reads a key from the state file. Never `source` it: it is generated
# output, not configuration.
state_get() {
  [ -f "${STATE_FILE}" ] || return 0
  sed -n "s/^${1}=\([^[:space:]]\+\)$/\1/p" "${STATE_FILE}" | tail -1
}

if [ "${1:-}" = "--show" ]; then
  if [ -f "${STATE_FILE}" ]; then
    cat "${STATE_FILE}"
  else
    echo "/!\\ No ${STATE_FILE}: run ./setup <env_file> first"
    exit 1
  fi
  exit 0
fi

# What the caller exported wins over what is remembered. Captured here,
# before anything else writes URL_PORT.
URL_PORT_FROM_ENV="${URL_PORT:-}"

ENV_FILE="${1:-$(state_get SETUP_ENV_FILE)}"
ENV_FILE="${ENV_FILE:-.env.dev}"
if [ -z "${1:-}" ] && [ -f "${STATE_FILE}" ]; then
  echo "▸ Reusing the remembered environment file: ${ENV_FILE}"
fi

# --------------------------------------------------------------------------
# Generating the development secrets.
#
# Nothing is ever written anywhere but into the environment file, itself
# gitignored (.env.* except .env.example): secretlint therefore never sees
# anything go past.
gen_hex() { openssl rand -hex 32; }     # 64 characters, nothing to escape in a URL
gen_key() { openssl rand -base64 32; }  # 32 bytes, for AES-256-GCM

if [ ! -f "${ENV_FILE}" ]; then
  DB_PASS="$(gen_hex)"
  umask 077   # the file is born 0600
  cat > "${ENV_FILE}" <<EOF
# Generated by ./setup on $(date -Iseconds). NEVER committed (see .gitignore).
# Unprefixed variables are read by Compose, Traefik and Postgres; the
# NUXT_-prefixed ones are read by the application AT STARTUP.

APP_ENV=dev
URL_HOST=localhost
# 8000 and not 8080: 8080 is used by work projects.
URL_PORT=8000

POSTGRES_DB=unmaxdinfo
POSTGRES_USER=unmaxdinfo
POSTGRES_PASSWORD=${DB_PASS}
DB_HOST=db
DB_PORT=5432
# Read by drizzle-kit, which is not Nitro and ignores the NUXT_ prefix.
DATABASE_URL=postgres://unmaxdinfo:${DB_PASS}@db:5432/unmaxdinfo

# --- Application ----------------------------------------------------------
NUXT_DATABASE_URL=postgres://unmaxdinfo:${DB_PASS}@db:5432/unmaxdinfo
NUXT_SESSION_PASSWORD=$(gen_hex)
NUXT_SECRET_ENCRYPTION_KEY=$(gen_key)
NUXT_SESSION_NAME=umdi_session
NUXT_SESSION_MAX_AGE=1209600
NUXT_PUBLIC_APP_ENV=dev
NUXT_PUBLIC_BASE_URL=http://localhost:8000

# --- To fill in yourself (lots 4 to 6) ------------------------------------
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google
NUXT_BOOTSTRAP_TECH_EMAIL=
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=unmaxdinfo-media
NUXT_R2_ENDPOINT=
NUXT_PUBLIC_R2_BASE_URL=
NUXT_INSTAGRAM_APP_ID=
NUXT_INSTAGRAM_APP_SECRET=
NUXT_INSTAGRAM_SYNC_INTERVAL_MINUTES=60
NUXT_SCHEDULER_ENABLED=false
EOF
  umask 022
  echo "▸ ${ENV_FILE} created, development secrets generated."
  echo "  Fill in the Google, R2 and Instagram credentials when the time comes,"
  echo "  then run ./setup again."
  exit 1
fi

# shellcheck disable=SC1090
source "${ENV_FILE}"
export ENV_FILE

# What the ENVIRONMENT FILE declares. Captured right after sourcing, before
# the remembered value gets a chance to override it.
URL_PORT_FROM_FILE="${URL_PORT:-}"

APP_ENV="${APP_ENV:-dev}"

# Fills in an empty secret in place. IN DEVELOPMENT ONLY: in preview and in
# production, a missing secret must FAIL the startup, never be invented
# silently.
ensure_secret() {
  [ "${APP_ENV}" = "dev" ] || return 0
  local name="${1}" gen="${2}" val
  val="$(sed -n "s/^${name}=\(.*\)$/\1/p" "${ENV_FILE}" | tail -1)"
  [ -n "${val}" ] && return 0
  local fresh; fresh="$(${gen})"
  # The | separator: base64 contains / and + but never |
  sed -i "s|^${name}=.*$|${name}=${fresh}|" "${ENV_FILE}"
  echo "▸ ${name} was empty: development secret generated in ${ENV_FILE}"
}
ensure_secret NUXT_SESSION_PASSWORD gen_hex
ensure_secret NUXT_SECRET_ENCRYPTION_KEY gen_key

# --------------------------------------------------------------------------
# Instance name: user + folder, which allows several clones side by side.
# Compose requires lowercase alphanumerics, « - » and « _ ».
if [ -z "${INSTANCE_NAME:-}" ]; then
  CLEAN_USER="${USER,,}"; CLEAN_USER="${CLEAN_USER//./-}"
  CLEAN_DIR="$(basename "$(pwd)")"; CLEAN_DIR="${CLEAN_DIR,,}"
  INSTANCE_NAME="${CLEAN_USER}-${CLEAN_DIR}"
fi
export INSTANCE_NAME

# --------------------------------------------------------------------------
# The environment picks the application override.
LOCAL_CONFIG="-f ./deploy/docker-compose-local-override.yml"
[ "${URL_SCHEME}" = "https" ] &&
  LOCAL_CONFIG="${LOCAL_CONFIG} -f ./deploy/docker-compose-https-override.yml"
case "${APP_ENV}" in
  dev)     APP_OVERRIDE="./deploy/docker-compose-dev-override.yml" ;;
  preview) APP_OVERRIDE="./deploy/docker-compose-preview-override.yml" ;;
  prod)    APP_OVERRIDE="./deploy/docker-compose-prod-override.yml"; LOCAL_CONFIG="" ;;
  *) echo "/!\\ APP_ENV must be dev, preview or prod (read: '${APP_ENV}')"; exit 1 ;;
esac

export URL_HOST="${URL_HOST:-localhost}"

# Priority, strongest to weakest:
#   1. what the caller exports       — an explicit, one-off intent
#   2. the environment file          — the folder's durable intent
#   3. the remembered value          — mere convenience, when nothing says
#   4. the default
#
# The file comes BEFORE the memory: without that, changing URL_PORT in
# .env.dev had no effect and nothing explained why.
URL_PORT_SOURCE="default"
if [ -n "${URL_PORT_FROM_ENV}" ]; then
  URL_PORT="${URL_PORT_FROM_ENV}"; URL_PORT_SOURCE="exported URL_PORT"
elif [ -n "${URL_PORT_FROM_FILE}" ]; then
  URL_PORT="${URL_PORT_FROM_FILE}"; URL_PORT_SOURCE="${ENV_FILE}"
elif REMEMBERED_PORT="$(state_get SETUP_URL_PORT)" && [ -n "${REMEMBERED_PORT}" ]; then
  if [[ "${REMEMBERED_PORT}" =~ ^[0-9]+$ ]]; then
    URL_PORT="${REMEMBERED_PORT}"; URL_PORT_SOURCE="remembered"
  else
    echo "/!\\ ${STATE_FILE}: SETUP_URL_PORT='${REMEMBERED_PORT}' ignored (not a number)"
  fi
fi
export URL_PORT="${URL_PORT:-8000}"

# The upper bound keeps DASHBOARD_PORT within the range of valid ports.
if ! [[ "${URL_PORT}" =~ ^[0-9]+$ ]] || ((URL_PORT < 1024 || URL_PORT > 55535)); then
  echo "/!\\ URL_PORT must be an integer between 1024 and 55535 (read: '${URL_PORT}')"
  exit 1
fi

if [ "${APP_ENV}" != "prod" ]; then
  # Every published port DERIVES from URL_PORT, by a simple offset: changing
  # URL_PORT is enough to move the whole instance, which allows running
  # several clones side by side — or leaving 8080 to work projects.
  #
  # Fixed offsets rather than a calculation relative to the old default:
  # « + 10000 » reads and checks in your head, where
  # « 18080 + (URL_PORT - 8080) » said exactly the same thing without anyone
  # being able to see it.
  export DASHBOARD_PORT="${DASHBOARD_PORT:-$((URL_PORT + 10000))}"
  export DB_TEST_PORT="${DB_TEST_PORT:-$((URL_PORT + 7000))}"
fi

export APP_IMAGE="${APP_IMAGE:-unmaxdinfo:${INSTANCE_NAME}}"
export MIGRATE_IMAGE="${MIGRATE_IMAGE:-unmaxdinfo-migrate:${INSTANCE_NAME}}"

# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# Local HTTPS, enabled by URL_SCHEME=https in the environment file.
#
# Why bother in development: `Secure` cookies are not set over plain HTTP,
# `SameSite` does not behave the same, and Google requires HTTPS redirect
# URIs outside localhost. Debugging authentication AND the protocol at the
# same time is the surest way to understand neither.
export URL_SCHEME="${URL_SCHEME:-http}"
INTERNAL_PORT=80
REDIRECTION_BLOCK=""
CERTS_DIR="./deploy/certs"

if [ "${URL_SCHEME}" = "https" ]; then
  mkdir -p "${CERTS_DIR}"
  if [ ! -f "${CERTS_DIR}/local.pem" ]; then
    if command -v mkcert >/dev/null 2>&1; then
      # mkcert produces a certificate the browser ACCEPTS, provided its
      # authority is installed — `mkcert -install`, once.
      mkcert -cert-file "${CERTS_DIR}/local.pem" -key-file "${CERTS_DIR}/local-key.pem" \
        "${URL_HOST:-localhost}" localhost 127.0.0.1 >/dev/null 2>&1
      echo "▸ mkcert certificate generated for ${URL_HOST:-localhost}"
    else
      # Self-signed fallback: the plumbing works, but the browser will show
      # a warning. Enough to check cookie behaviour, not enough for daily
      # work.
      openssl req -x509 -newkey rsa:2048 -sha256 -days 825 -nodes \
        -keyout "${CERTS_DIR}/local-key.pem" -out "${CERTS_DIR}/local.pem" \
        -subj "/CN=${URL_HOST:-localhost}" \
        -addext "subjectAltName=DNS:${URL_HOST:-localhost},DNS:localhost,IP:127.0.0.1" \
        >/dev/null 2>&1
      echo "▸ SELF-SIGNED certificate generated (the browser will warn)."
      echo "  For an accepted certificate: install mkcert, run 'mkcert -install',"
      echo "  delete ${CERTS_DIR}/ then run ./setup again."
    fi
  fi
  # All plain traffic is redirected: otherwise you end up testing over HTTP
  # by accident and miss the very problems you were looking for.
  INTERNAL_PORT=443
  REDIRECTION_BLOCK="    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https"
fi
export REDIRECTION_BLOCK INTERNAL_PORT

TRAEFIK_BEFORE=""
[ -f ./deploy/config/traefik-dev.yml ] && TRAEFIK_BEFORE="$(cat ./deploy/config/traefik-dev.yml)"
envsubst < ./deploy/config/traefik-dev.yml.tpl > ./deploy/config/traefik-dev.yml
mkdir -p ./deploy/dynamic
if [ "${URL_SCHEME}" = "https" ]; then
  envsubst < ./deploy/config/traefik-tls.yml.tpl > ./deploy/dynamic/tls.yml
else
  rm -f ./deploy/dynamic/tls.yml
fi

# Traefik only reads its STATIC configuration at startup. Regenerating the
# file under an already running container changes nothing, and `up -d` does
# not recreate it since the service definition has not moved: you believe
# you applied a setting that is not active. A trap lived through, hence this
# notice.
if [ -n "${TRAEFIK_BEFORE}" ] &&
   [ "${TRAEFIK_BEFORE}" != "$(cat ./deploy/config/traefik-dev.yml)" ] &&
   docker ps --filter "label=com.docker.compose.project=${INSTANCE_NAME}" \
             --filter "name=-rp-" --format '{{.Names}}' 2>/dev/null | grep -q .; then
  TRAEFIK_NEEDS_RECREATE=1
fi

# --------------------------------------------------------------------------
# Port check BEFORE writing a compose that could not start. dockerd's
# message only arrives at `up` and does not say WHO holds the port, while
# the culprit is almost always another clone of this repository.
port_holder() {
  docker ps --filter "publish=${1}" \
    --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sort -u | head -1
}

check_port() {
  local port="${1}" label="${2}" holder
  [ -z "${port}" ] && return 0
  holder="$(port_holder "${port}")"
  if [ -n "${holder}" ]; then
    # Our own containers on our own ports: simply restarting with the stack
    # already up. Say nothing.
    [ "${holder}" = "${INSTANCE_NAME}" ] && return 0
    echo "/!\\ Port ${port} (${label}) is already published by docker project '${holder}'"
    return 1
  fi
  if command -v ss >/dev/null 2>&1 && ss -ltnH "sport = :${port}" 2>/dev/null | grep -q .; then
    echo "/!\\ Port ${port} (${label}) is already taken by a local process"
    return 1
  fi
  return 0
}

if [ -z "${SKIP_PORT_CHECK:-}" ] && [ "${APP_ENV}" != "prod" ]; then
  PORTS_BUSY=0
  check_port "${URL_PORT}" "site" || PORTS_BUSY=1
  check_port "${DASHBOARD_PORT}" "traefik dashboard" || PORTS_BUSY=1
  [ "${APP_ENV}" = "dev" ] && { check_port "${DB_TEST_PORT}" "test database" || PORTS_BUSY=1; }
  if [ "${PORTS_BUSY}" = "1" ]; then
    # Suggest the first offset whose derived ports are ALL free, so the fix
    # fits in one copy-paste.
    for OFFSET in $(seq 0 9); do
      CANDIDATE=$((URL_PORT + 1 + OFFSET))
      if [ -z "$(port_holder ${CANDIDATE})" ] &&
         [ -z "$(port_holder $((CANDIDATE + 10000)))" ]; then
        echo "    Try: URL_PORT=${CANDIDATE} ./setup ${ENV_FILE}"
        break
      fi
    done
    echo "    Or set SKIP_PORT_CHECK=1 to generate anyway."
    exit 1
  fi
fi

# --------------------------------------------------------------------------
# shellcheck disable=SC2086
# WARNING: `docker compose config` ALWAYS unfolds the contents of env_file
# into environment: blocks. Secrets therefore end up in the clear in the
# artefact, and there is no option to avoid it (--no-env-resolution was
# tried: no effect). The sources under deploy/ keep env_file all the same,
# which remains the right form — one source of truth, no duplication in the
# repository.
#
# So we protect the artefact: a restrictive umask while writing, then 0600
# permissions. It is gitignored besides, so it never reaches the repository
# — which counts double now that it is public.
(
  umask 077
  # --profile migrate is necessary: without it, `config` plainly DISCARDS
  # the services attached to a profile, and the migration container would be
  # absent from the artefact. Including it does not start it — `up` still
  # ignores it, which is the whole point.
  docker compose -p "${INSTANCE_NAME}" --project-directory . \
    -f ./deploy/docker-compose.yml -f "${APP_OVERRIDE}" ${LOCAL_CONFIG} \
    --profile migrate \
    config > docker-compose.yml
)
chmod 600 docker-compose.yml

sed -i -e "s#$(pwd)#.#g" docker-compose.yml

# Written only once the generation succeeded, so the state never describes a
# stack that could not be built. Deliberately not secret — no credentials —
# so a shell prompt can read it.
cat > "${STATE_FILE}" <<EOF
# Generated by ./setup — do not edit, regenerated on every run
SETUP_INSTANCE_NAME=${INSTANCE_NAME}
SETUP_ENV_FILE=${ENV_FILE}
SETUP_APP_ENV=${APP_ENV}
SETUP_URL_PORT=${URL_PORT}
SETUP_DASHBOARD_PORT=${DASHBOARD_PORT:-}
SETUP_DB_TEST_PORT=${DB_TEST_PORT:-}
SETUP_PUBLIC_URL=${URL_SCHEME}://${URL_HOST}:${URL_PORT}
SETUP_URL_SCHEME=${URL_SCHEME}
SETUP_UPDATED_AT=$(date -Iseconds)
EOF

echo "-------------------------------------------------------"
echo "INSTANCE READY: ${INSTANCE_NAME}"
echo "-------------------------------------------------------"
echo "Environment : ${APP_ENV}"
echo "Env file    : ${ENV_FILE}"
echo "Port        : ${URL_PORT} (${URL_PORT_SOURCE})"
echo "Site        : ${URL_SCHEME}://${URL_HOST}:${URL_PORT}"
echo "Probe       : ${URL_SCHEME}://${URL_HOST}:${URL_PORT}/api/health"
[ "${APP_ENV}" != "prod" ] && echo "Traefik     : http://localhost:${DASHBOARD_PORT}"
[ "${APP_ENV}" = "dev" ] && echo "Test DB     : 127.0.0.1:${DB_TEST_PORT}"
echo "-------------------------------------------------------"
echo "Next:"
echo "  docker compose run --rm migrate     # applies the migrations"
echo "  docker compose up -d --wait         # starts the stack"
if [ -n "${TRAEFIK_NEEDS_RECREATE:-}" ]; then
  echo "-------------------------------------------------------"
  echo "/!\ The Traefik configuration changed and the container is still running."
  echo "    It will only re-read it on restart:"
  echo "      docker compose up -d --force-recreate rp"
fi
echo "-------------------------------------------------------"
