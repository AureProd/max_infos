# ============================================================================
#  unmaxdinfo.fr — variables d'environnement
#
#  Ce fichier est un MODÈLE : il ne contient que des valeurs vides ou
#  publiques, jamais un secret. Il est le seul .env commité.
#
#  En développement, ./setup crée .env.dev et remplit lui-même les secrets
#  locaux (mot de passe Postgres, clé de session, clé de chiffrement). Il
#  n'y a normalement rien à copier à la main.
#
#  Deux familles de variables, et la frontière compte :
#   - SANS préfixe : lues par Docker Compose, Traefik, Postgres et
#     drizzle-kit.
#   - Préfixées NUXT_ : lues par l'application AU DÉMARRAGE. C'est le seul
#     mécanisme qui injecte à l'exécution ; tout ce qui serait lu par
#     process.env dans nuxt.config.ts serait figé au moment du build, et une
#     image construite en CI embarquerait les variables du runner.
#     NUXT_PUBLIC_* part jusqu'au navigateur — n'y mettre que du public.
# ============================================================================

# --- Environnement --------------------------------------------------------
APP_ENV=dev                       # dev | preview | prod
URL_HOST=unmaxdinfo.localhost     # unmaxdinfo.fr en production
URL_PORT=8080                     # port local du Traefik de dev (ignoré en prod)
# http | https. En https, ./setup génère le certificat (mkcert si présent,
# auto-signé sinon) et Traefik redirige tout le trafic en clair.
URL_SCHEME=http

# --- Images de conteneurs (renseignées par la CI en production) -----------
APP_IMAGE=ghcr.io/OWNER/unmaxdinfo:dev
MIGRATE_IMAGE=ghcr.io/OWNER/unmaxdinfo-migrate:dev

# --- Base de données ------------------------------------------------------
POSTGRES_DB=unmaxdinfo
POSTGRES_USER=unmaxdinfo
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432
# Lue par drizzle-kit, qui n'est pas Nitro et ignore le préfixe NUXT_.
DATABASE_URL=

# --- Application ----------------------------------------------------------
NUXT_DATABASE_URL=

# Chiffrement des jetons tiers stockés en base (table `secret`).
# AES-256-GCM avec le node:crypto natif — Fernet n'existe pas en Node et ne
# doit pas être réimplémenté. Clé de 32 octets : openssl rand -base64 32
NUXT_SECRET_ENCRYPTION_KEY=

# Signature des cookies de session : openssl rand -hex 32
# nuxt-auth-utils impose ce nom exact et un minimum de 32 caractères.
NUXT_SESSION_PASSWORD=
NUXT_SESSION_NAME=umdi_session
NUXT_SESSION_MAX_AGE=1209600      # 14 jours

# --- Authentification Google ---------------------------------------------
# Noms imposés par nuxt-auth-utils : ils alimentent oauth.google.*
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# URI de redirection déclarée dans la console Google. En développement :
# http://unmaxdinfo.localhost:8080/api/auth/google
NUXT_OAUTH_GOOGLE_REDIRECT_URL=
# Premier compte technique, amorce la table app_user au démarrage.
NUXT_BOOTSTRAP_TECH_EMAIL=

# --- Cloudflare R2 (compatible S3) ---------------------------------------
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=unmaxdinfo-media
NUXT_R2_ENDPOINT=

# --- Instagram (Instagram API with Instagram Login) ----------------------
# Le jeton d'accès n'est PAS ici : il est chiffré en base après l'OAuth.
NUXT_INSTAGRAM_APP_ID=
NUXT_INSTAGRAM_APP_SECRET=
NUXT_INSTAGRAM_SYNC_INTERVAL_MINUTES=60

# Les tâches planifiées ne tournent que là où c'est vrai. Le dédoublonnage
# de Nitro est PAR INSTANCE : avec deux répliques et cette valeur à true
# partout, Instagram serait synchronisé deux fois.
NUXT_SCHEDULER_ENABLED=false

# --- Exposé au navigateur -------------------------------------------------
NUXT_PUBLIC_APP_ENV=dev
NUXT_PUBLIC_BASE_URL=http://unmaxdinfo.localhost:8080
NUXT_PUBLIC_R2_BASE_URL=https://media.unmaxdinfo.fr
