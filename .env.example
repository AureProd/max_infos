# ============================================================================
#  unmaxdinfo.fr — variables d'environnement
#  Copier en .env.dev (local) ou .env.prod (serveur). JAMAIS commité.
#  Générer les secrets avec : openssl rand -hex 32
# ============================================================================

# --- Environnement --------------------------------------------------------
APP_ENV=dev                       # dev | preview | prod
URL_HOST=unmaxdinfo.localhost     # unmaxdinfo.fr en production
URL_PORT=8080                     # port local du Traefik de dev (ignoré en prod)
PUBLIC_BASE_URL=http://unmaxdinfo.localhost:8080
LOG_LEVEL=INFO

# --- Base de données ------------------------------------------------------
POSTGRES_DB=unmaxdinfo
POSTGRES_USER=unmaxdinfo
POSTGRES_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# --- Chiffrement des jetons tiers stockés en base (table `secret`) --------
# Clé Fernet : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- Signature des cookies de session ------------------------------------
SESSION_SECRET=
SESSION_COOKIE_NAME=umdi_session
SESSION_MAX_AGE=1209600           # 14 jours

# --- Authentification Google ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Premier compte technique, amorce la table app_user au démarrage
BOOTSTRAP_TECH_EMAIL=

# --- Cloudflare R2 (compatible S3) ---------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unmaxdinfo-media
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=https://media.unmaxdinfo.fr

# --- Instagram (Instagram API with Instagram Login) ----------------------
# Le jeton d'accès n'est PAS ici : il est chiffré en base après l'OAuth.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SYNC_INTERVAL_MINUTES=60

# --- Images de conteneurs (renseigné par la CI en production) ------------
API_IMAGE=ghcr.io/OWNER/unmaxdinfo:dev
