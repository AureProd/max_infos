# ============================================================================
#  unmaxdinfo.fr — environment variables
#
#  This file is a TEMPLATE: it holds nothing but empty or public values,
#  never a secret. It is the only .env committed.
#
#  In development, ./setup creates .env.dev and fills the local secrets in
#  itself (Postgres password, session key, encryption key). There is
#  normally nothing to copy by hand.
#
#  IN PRODUCTION this file is nobody's template: the VPS .env is built by
#  GitHub Actions from the secrets and variables of the `production`
#  environment, and rewritten on every deployment. Adding a variable here
#  means adding it to the « Render the production .env » step of
#  .github/workflows/deploy.yml too.
#
#  Two families of variables, and the border matters:
#   - WITHOUT a prefix: read by Docker Compose, Traefik, Postgres and
#     drizzle-kit.
#   - NUXT_-prefixed: read by the application AT STARTUP. It is the only
#     mechanism that injects at runtime; anything read through process.env
#     in nuxt.config.ts would be frozen at build time, and an image built in
#     CI would embed the runner's variables.
#     NUXT_PUBLIC_* travels to the browser — put nothing but public there.
# ============================================================================

# --- Environment ----------------------------------------------------------
APP_ENV=dev                       # dev | preview | prod
URL_HOST=unmaxdinfo.localhost     # unmaxdinfo.fr in production
URL_PORT=8000                     # local dev Traefik port (ignored in prod)
# http | https. Over https, ./setup generates the certificate (mkcert when
# present, self-signed otherwise) and Traefik redirects all plain traffic.
URL_SCHEME=http

# --- Container images (set by CI in production) ---------------------------
APP_IMAGE=ghcr.io/OWNER/unmaxdinfo:dev
MIGRATE_IMAGE=ghcr.io/OWNER/unmaxdinfo-migrate:dev

# --- Database -------------------------------------------------------------
POSTGRES_DB=unmaxdinfo
POSTGRES_USER=unmaxdinfo
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432
# Read by drizzle-kit, which is not Nitro and ignores the NUXT_ prefix.
DATABASE_URL=

# --- Application ----------------------------------------------------------
NUXT_DATABASE_URL=

# Encryption of third-party tokens stored in the database (`secret` table).
# AES-256-GCM with the native node:crypto — Fernet does not exist in Node
# and must not be reimplemented. A 32-byte key: openssl rand -base64 32
NUXT_SECRET_ENCRYPTION_KEY=

# Session cookie signing: openssl rand -hex 32
# nuxt-auth-utils mandates this exact name and at least 32 characters.
# The cookie name and its lifetime are fixed in nuxt.config.ts: those are
# design choices, not operational settings.
NUXT_SESSION_PASSWORD=

# --- Authentification Google ---------------------------------------------
# Names mandated by nuxt-auth-utils: they feed oauth.google.*
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Redirect URI declared in the Google console. In development:
# http://unmaxdinfo.localhost:8000/api/auth/google
NUXT_OAUTH_GOOGLE_REDIRECT_URL=
# First technical account, bootstraps the app_user table at startup.
NUXT_BOOTSTRAP_TECH_EMAIL=

# --- Cloudflare R2 (compatible S3) ---------------------------------------
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=unmaxdinfo-media
NUXT_R2_ENDPOINT=

# --- Instagram (Instagram API with Instagram Login) ----------------------
# The access token is NOT here: it is encrypted in the database after OAuth.
NUXT_INSTAGRAM_APP_ID=
NUXT_INSTAGRAM_APP_SECRET=
NUXT_INSTAGRAM_SYNC_INTERVAL_MINUTES=60

# Scheduled tasks only run where this is true. Nitro deduplicates PER
# INSTANCE: with two replicas and this value true everywhere, Instagram
# would be synced twice.
NUXT_SCHEDULER_ENABLED=false

# --- Exposed to the browser -----------------------------------------------
NUXT_PUBLIC_APP_ENV=dev
NUXT_PUBLIC_BASE_URL=http://unmaxdinfo.localhost:8000
NUXT_PUBLIC_R2_BASE_URL=https://media.unmaxdinfo.fr
