# What must never enter the build context.
node_modules
# A build output from the host would invalidate the cache on every
# iteration and could overwrite the one built inside the container.
.nuxt
.output
.data
coverage

# Leftover from the mock-up, converted as we go then removed.
frontend

# Of no use to the image.
mockup
docs
.git
.github
.vscode
.idea
test
**/*.log

# Secrets and generated artefacts.
.env
.env.*
!.env.example
docker-compose.yml
.setup-state
deploy/config/traefik-dev.yml
*.pem
*.key
